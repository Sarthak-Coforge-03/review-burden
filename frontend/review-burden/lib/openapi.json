{
  "openapi": "3.1.0",
  "info": {
    "title": "Review Health Dashboard",
    "version": "0.1.0"
  },
  "paths": {
    "/api/people": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "List People",
        "description": "Everyone, manager first, then by name. Open to any viewer: the role switcher needs the full roster.",
        "operationId": "list_people_api_people_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Person"
                  },
                  "type": "array",
                  "title": "Response List People Api People Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/people/profiles": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "List Profiles",
        "description": "Every developer's profile, by name. Manager only.",
        "operationId": "list_profiles_api_people_profiles_get",
        "parameters": [
          {
            "name": "x-viewer-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who is viewing. Demo only: there is no real auth.",
              "title": "X-Viewer-Id"
            },
            "description": "Who is viewing. Demo only: there is no real auth."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PersonProfile"
                  },
                  "title": "Response List Profiles Api People Profiles Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/people/{person_id}/profile": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "Get Profile",
        "description": "One person's profile. The manager can see anyone's; a developer only their own.",
        "operationId": "get_profile_api_people__person_id__profile_get",
        "parameters": [
          {
            "name": "person_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Person Id"
            }
          },
          {
            "name": "x-viewer-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who is viewing. Demo only: there is no real auth.",
              "title": "X-Viewer-Id"
            },
            "description": "Who is viewing. Demo only: there is no real auth."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/flags": {
      "get": {
        "tags": [
          "flags"
        ],
        "summary": "List Flags",
        "description": "Flags, newest first. The manager sees all; a developer sees only flags about themselves.",
        "operationId": "list_flags_api_flags_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/FlagStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "rule_key",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RuleKey"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rule Key"
            }
          },
          {
            "name": "person_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Person Id"
            }
          },
          {
            "name": "x-viewer-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who is viewing. Demo only: there is no real auth.",
              "title": "X-Viewer-Id"
            },
            "description": "Who is viewing. Demo only: there is no real auth."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlagOut"
                  },
                  "title": "Response List Flags Api Flags Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/flags/{flag_id}": {
      "patch": {
        "tags": [
          "flags"
        ],
        "summary": "Triage Flag",
        "description": "Acknowledge, dismiss (with a reason) or reopen a flag, and optionally set its note.",
        "operationId": "triage_flag_api_flags__flag_id__patch",
        "parameters": [
          {
            "name": "flag_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Flag Id"
            }
          },
          {
            "name": "x-viewer-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who is viewing. Demo only: there is no real auth.",
              "title": "X-Viewer-Id"
            },
            "description": "Who is viewing. Demo only: there is no real auth."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlagUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlagOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/load": {
      "get": {
        "tags": [
          "load"
        ],
        "summary": "Get Load",
        "description": "Who carries the review work: weekly history, the load rule's numbers now, and waiting requests. Manager only.",
        "operationId": "get_load_api_load_get",
        "parameters": [
          {
            "name": "weeks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 52,
              "minimum": 1,
              "description": "How many weeks of history to chart.",
              "default": 12,
              "title": "Weeks"
            },
            "description": "How many weeks of history to chart."
          },
          {
            "name": "x-viewer-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who is viewing. Demo only: there is no real auth.",
              "title": "X-Viewer-Id"
            },
            "description": "Who is viewing. Demo only: there is no real auth."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoadReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/quality": {
      "get": {
        "tags": [
          "quality"
        ],
        "summary": "Get Quality",
        "description": "Per reviewer: approval speed, comment depth, rubber stamps and escapes, with team medians. Manager only.",
        "operationId": "get_quality_api_quality_get",
        "parameters": [
          {
            "name": "weeks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 52,
              "minimum": 1,
              "description": "How many weeks of reviews to include.",
              "default": 12,
              "title": "Weeks"
            },
            "description": "How many weeks of reviews to include."
          },
          {
            "name": "x-viewer-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who is viewing. Demo only: there is no real auth.",
              "title": "X-Viewer-Id"
            },
            "description": "Who is viewing. Demo only: there is no real auth."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualityReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FlagOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "rule_key": {
            "$ref": "#/components/schemas/RuleKey"
          },
          "status": {
            "$ref": "#/components/schemas/FlagStatus"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FlagRole"
              },
              {
                "type": "null"
              }
            ],
            "description": "Which side of the review `person` was on; null for team-level flags."
          },
          "person": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ]
          },
          "pull_request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PullRequestRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence",
            "description": "Rule-specific facts behind the flag; keys depend on `rule_key`."
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "dismiss_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dismiss Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "rule_key",
          "status",
          "role",
          "person",
          "pull_request",
          "occurred_at",
          "evidence",
          "note",
          "dismiss_reason"
        ],
        "title": "FlagOut"
      },
      "FlagRole": {
        "type": "string",
        "enum": [
          "author",
          "reviewer"
        ],
        "title": "FlagRole",
        "description": "Which side of the review a flagged person was on."
      },
      "FlagStatus": {
        "type": "string",
        "enum": [
          "open",
          "acknowledged",
          "dismissed"
        ],
        "title": "FlagStatus"
      },
      "FlagUpdate": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/FlagStatus"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "Omit to keep the current note; null or blank clears it."
          },
          "dismiss_reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Dismiss Reason",
            "description": "Required when dismissing; cleared for any other status."
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "FlagUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LoadReport": {
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "week_starts": {
            "items": {
              "type": "string",
              "format": "date-time"
            },
            "type": "array",
            "title": "Week Starts",
            "description": "Oldest first. Each week is the 7 days after its start; the last one ends at as_of."
          },
          "window_days": {
            "type": "integer",
            "title": "Window Days"
          },
          "team_reviews": {
            "type": "integer",
            "title": "Team Reviews",
            "description": "Reviews by all developers in the window (the manager is not counted)."
          },
          "team_median": {
            "type": "number",
            "title": "Team Median"
          },
          "top2_share": {
            "type": "number",
            "title": "Top2 Share",
            "description": "Share of team_reviews done by the two busiest developers."
          },
          "top2_share_threshold": {
            "type": "number",
            "title": "Top2 Share Threshold"
          },
          "median_multiple_threshold": {
            "type": "number",
            "title": "Median Multiple Threshold"
          },
          "concentrated": {
            "type": "boolean",
            "title": "Concentrated",
            "description": "Whether the load_concentration rule fires on these numbers."
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/LoadRow"
            },
            "type": "array",
            "title": "People",
            "description": "Developers, busiest reviewer first."
          }
        },
        "type": "object",
        "required": [
          "as_of",
          "week_starts",
          "window_days",
          "team_reviews",
          "team_median",
          "top2_share",
          "top2_share_threshold",
          "median_multiple_threshold",
          "concentrated",
          "people"
        ],
        "title": "LoadReport"
      },
      "LoadRow": {
        "properties": {
          "person": {
            "$ref": "#/components/schemas/Person"
          },
          "weekly": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Weekly",
            "description": "Reviews per week, aligned with LoadReport.week_starts."
          },
          "reviews": {
            "type": "integer",
            "title": "Reviews",
            "description": "Reviews in the load window."
          },
          "share": {
            "type": "number",
            "title": "Share",
            "description": "reviews / team_reviews, 0 to 1."
          },
          "median_multiple": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median Multiple",
            "description": "reviews / team_median; null when the median is 0."
          },
          "over_median_multiple": {
            "type": "boolean",
            "title": "Over Median Multiple"
          },
          "pending": {
            "type": "integer",
            "title": "Pending",
            "description": "Review requests waiting on this person now."
          },
          "oldest_pending_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Oldest Pending Hours",
            "description": "Age of the oldest waiting request; null if none."
          }
        },
        "type": "object",
        "required": [
          "person",
          "weekly",
          "reviews",
          "share",
          "median_multiple",
          "over_median_multiple",
          "pending",
          "oldest_pending_hours"
        ],
        "title": "LoadRow"
      },
      "PatternOut": {
        "properties": {
          "rule_key": {
            "$ref": "#/components/schemas/RuleKey"
          },
          "role": {
            "$ref": "#/components/schemas/FlagRole"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "Non-dismissed flags of this rule inside the window."
          },
          "window_days": {
            "type": "integer",
            "title": "Window Days"
          },
          "pull_requests": {
            "items": {
              "$ref": "#/components/schemas/PullRequestRef"
            },
            "type": "array",
            "title": "Pull Requests"
          }
        },
        "type": "object",
        "required": [
          "rule_key",
          "role",
          "count",
          "window_days",
          "pull_requests"
        ],
        "title": "PatternOut"
      },
      "PendingReview": {
        "properties": {
          "pull_request": {
            "$ref": "#/components/schemas/PullRequestRef"
          },
          "requested_at": {
            "type": "string",
            "format": "date-time",
            "title": "Requested At"
          },
          "waiting_hours": {
            "type": "number",
            "title": "Waiting Hours"
          },
          "stale": {
            "type": "boolean",
            "title": "Stale",
            "description": "Waiting longer than the stale_backlog threshold."
          }
        },
        "type": "object",
        "required": [
          "pull_request",
          "requested_at",
          "waiting_hours",
          "stale"
        ],
        "title": "PendingReview"
      },
      "Person": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "Person"
      },
      "PersonProfile": {
        "properties": {
          "person": {
            "$ref": "#/components/schemas/Person"
          },
          "as_author": {
            "$ref": "#/components/schemas/RoleSummary"
          },
          "as_reviewer": {
            "$ref": "#/components/schemas/RoleSummary"
          },
          "patterns": {
            "items": {
              "$ref": "#/components/schemas/PatternOut"
            },
            "type": "array",
            "title": "Patterns",
            "description": "Active repeat patterns, computed now; dismissed flags don't count."
          },
          "review_debt": {
            "items": {
              "$ref": "#/components/schemas/PendingReview"
            },
            "type": "array",
            "title": "Review Debt",
            "description": "Review requests waiting on this person, oldest first."
          },
          "activity": {
            "$ref": "#/components/schemas/ReviewActivity"
          }
        },
        "type": "object",
        "required": [
          "person",
          "as_author",
          "as_reviewer",
          "patterns",
          "review_debt",
          "activity"
        ],
        "title": "PersonProfile"
      },
      "PullRequestRef": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author_id": {
            "type": "integer",
            "title": "Author Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "author_id"
        ],
        "title": "PullRequestRef"
      },
      "QualityMedians": {
        "properties": {
          "minutes_per_100_lines": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minutes Per 100 Lines"
          },
          "comments_per_100_lines": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comments Per 100 Lines"
          },
          "substantive_share": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Substantive Share"
          },
          "escape_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Escape Rate"
          }
        },
        "type": "object",
        "required": [
          "minutes_per_100_lines",
          "comments_per_100_lines",
          "substantive_share",
          "escape_rate"
        ],
        "title": "QualityMedians",
        "description": "Medians across developers who have a value; null when nobody does."
      },
      "QualityReport": {
        "properties": {
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "title": "Since"
          },
          "weeks": {
            "type": "integer",
            "title": "Weeks"
          },
          "big_pr_lines": {
            "type": "integer",
            "title": "Big Pr Lines",
            "description": "The rubber_stamp rule's size threshold."
          },
          "escape_window_days": {
            "type": "integer",
            "title": "Escape Window Days"
          },
          "medians": {
            "$ref": "#/components/schemas/QualityMedians"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/QualityRow"
            },
            "type": "array",
            "title": "People",
            "description": "Developers, by name."
          }
        },
        "type": "object",
        "required": [
          "as_of",
          "since",
          "weeks",
          "big_pr_lines",
          "escape_window_days",
          "medians",
          "people"
        ],
        "title": "QualityReport"
      },
      "QualityRow": {
        "properties": {
          "person": {
            "$ref": "#/components/schemas/Person"
          },
          "reviews": {
            "type": "integer",
            "title": "Reviews",
            "description": "Reviews submitted in the period, any verdict."
          },
          "approvals": {
            "type": "integer",
            "title": "Approvals",
            "description": "PRs approved in the period (a re-approval of the same PR counts once)."
          },
          "minutes_per_100_lines": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minutes Per 100 Lines",
            "description": "Median minutes from PR opened to first approval, per 100 changed lines; null with no approvals."
          },
          "comments": {
            "type": "integer",
            "title": "Comments"
          },
          "comments_per_100_lines": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comments Per 100 Lines",
            "description": "Comments per 100 lines of the PRs reviewed."
          },
          "substantive_share": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Substantive Share",
            "description": "Share of comments that are substantive (the rubber_stamp rule's test); null with no comments."
          },
          "big_approvals": {
            "type": "integer",
            "title": "Big Approvals",
            "description": "Approved PRs at or over the rubber_stamp size threshold."
          },
          "stamped_big_approvals": {
            "type": "integer",
            "title": "Stamped Big Approvals",
            "description": "Of those, how many the rubber_stamp rule would flag."
          },
          "approved_merged": {
            "type": "integer",
            "title": "Approved Merged",
            "description": "Approved PRs merged by as_of."
          },
          "escapes": {
            "type": "integer",
            "title": "Escapes",
            "description": "Of those, how many needed a revert or hotfix within the escape window."
          },
          "escape_rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Escape Rate",
            "description": "escapes / approved_merged; null when nothing approved was merged."
          }
        },
        "type": "object",
        "required": [
          "person",
          "reviews",
          "approvals",
          "minutes_per_100_lines",
          "comments",
          "comments_per_100_lines",
          "substantive_share",
          "big_approvals",
          "stamped_big_approvals",
          "approved_merged",
          "escapes",
          "escape_rate"
        ],
        "title": "QualityRow"
      },
      "ReviewActivity": {
        "properties": {
          "window_days": {
            "type": "integer",
            "title": "Window Days"
          },
          "reviews_given": {
            "type": "integer",
            "title": "Reviews Given"
          },
          "team_reviews": {
            "type": "integer",
            "title": "Team Reviews",
            "description": "Reviews by all developers in the window (the manager is not counted)."
          },
          "share": {
            "type": "number",
            "title": "Share",
            "description": "reviews_given / team_reviews, 0 to 1."
          },
          "team_median": {
            "type": "number",
            "title": "Team Median",
            "description": "Median reviews per developer in the window."
          },
          "over_median_multiple": {
            "type": "boolean",
            "title": "Over Median Multiple",
            "description": "reviews_given is above the load_concentration rule's multiple of the team median."
          },
          "prs_opened": {
            "type": "integer",
            "title": "Prs Opened"
          }
        },
        "type": "object",
        "required": [
          "window_days",
          "reviews_given",
          "team_reviews",
          "share",
          "team_median",
          "over_median_multiple",
          "prs_opened"
        ],
        "title": "ReviewActivity"
      },
      "Role": {
        "type": "string",
        "enum": [
          "manager",
          "dev"
        ],
        "title": "Role"
      },
      "RoleSummary": {
        "properties": {
          "flags": {
            "items": {
              "$ref": "#/components/schemas/RuleCount"
            },
            "type": "array",
            "title": "Flags",
            "description": "Non-dismissed flags in this role, by rule; rules with none are left out."
          },
          "open": {
            "type": "integer",
            "title": "Open",
            "description": "How many of those are still open (not yet acknowledged)."
          }
        },
        "type": "object",
        "required": [
          "flags",
          "open"
        ],
        "title": "RoleSummary"
      },
      "RuleCount": {
        "properties": {
          "rule_key": {
            "$ref": "#/components/schemas/RuleKey"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "rule_key",
          "count"
        ],
        "title": "RuleCount"
      },
      "RuleKey": {
        "type": "string",
        "enum": [
          "merged_unreviewed",
          "merged_changes_pending",
          "self_approval",
          "rubber_stamp",
          "escape",
          "stale_backlog",
          "load_concentration"
        ],
        "title": "RuleKey"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
