{
  "openapi": "3.1.0",
  "info": {
    "title": "Review Health Dashboard",
    "version": "0.1.0"
  },
  "paths": {
    "/api/people": {
      "get": {
        "tags": [
          "people"
        ],
        "summary": "List People",
        "description": "Everyone, manager first, then by name. Open to any viewer: the role switcher needs the full roster.",
        "operationId": "list_people_api_people_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Person"
                  },
                  "type": "array",
                  "title": "Response List People Api People Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/flags": {
      "get": {
        "tags": [
          "flags"
        ],
        "summary": "List Flags",
        "description": "Flags, newest first. The manager sees all; a developer sees only flags about themselves.",
        "operationId": "list_flags_api_flags_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/FlagStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "rule_key",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RuleKey"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Rule Key"
            }
          },
          {
            "name": "person_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Person Id"
            }
          },
          {
            "name": "x-viewer-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who is viewing. Demo only: there is no real auth.",
              "title": "X-Viewer-Id"
            },
            "description": "Who is viewing. Demo only: there is no real auth."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FlagOut"
                  },
                  "title": "Response List Flags Api Flags Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/flags/{flag_id}": {
      "patch": {
        "tags": [
          "flags"
        ],
        "summary": "Triage Flag",
        "description": "Acknowledge, dismiss (with a reason) or reopen a flag, and optionally set its note.",
        "operationId": "triage_flag_api_flags__flag_id__patch",
        "parameters": [
          {
            "name": "flag_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Flag Id"
            }
          },
          {
            "name": "x-viewer-id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Who is viewing. Demo only: there is no real auth.",
              "title": "X-Viewer-Id"
            },
            "description": "Who is viewing. Demo only: there is no real auth."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlagUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlagOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FlagOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "rule_key": {
            "$ref": "#/components/schemas/RuleKey"
          },
          "status": {
            "$ref": "#/components/schemas/FlagStatus"
          },
          "role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FlagRole"
              },
              {
                "type": "null"
              }
            ],
            "description": "Which side of the review `person` was on; null for team-level flags."
          },
          "person": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "type": "null"
              }
            ]
          },
          "pull_request": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PullRequestRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence",
            "description": "Rule-specific facts behind the flag; keys depend on `rule_key`."
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "dismiss_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dismiss Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "rule_key",
          "status",
          "role",
          "person",
          "pull_request",
          "occurred_at",
          "evidence",
          "note",
          "dismiss_reason"
        ],
        "title": "FlagOut"
      },
      "FlagRole": {
        "type": "string",
        "enum": [
          "author",
          "reviewer"
        ],
        "title": "FlagRole",
        "description": "Which side of the review a flagged person was on."
      },
      "FlagStatus": {
        "type": "string",
        "enum": [
          "open",
          "acknowledged",
          "dismissed"
        ],
        "title": "FlagStatus"
      },
      "FlagUpdate": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/FlagStatus"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "Omit to keep the current note; null or blank clears it."
          },
          "dismiss_reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Dismiss Reason",
            "description": "Required when dismissing; cleared for any other status."
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "FlagUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "Person": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "role"
        ],
        "title": "Person"
      },
      "PullRequestRef": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author_id": {
            "type": "integer",
            "title": "Author Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "author_id"
        ],
        "title": "PullRequestRef"
      },
      "Role": {
        "type": "string",
        "enum": [
          "manager",
          "dev"
        ],
        "title": "Role"
      },
      "RuleKey": {
        "type": "string",
        "enum": [
          "merged_unreviewed",
          "merged_changes_pending",
          "self_approval",
          "rubber_stamp",
          "escape",
          "stale_backlog",
          "load_concentration"
        ],
        "title": "RuleKey"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
